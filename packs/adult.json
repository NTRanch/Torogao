  "arcLadder": [
    {
      "stage": 0,
      "label": "baseline",
      "agency": "hers",
      "scaffold": "Establish who she is before anything changes: anchors, refrain, the want stated in her own register."
    },
    {
      "stage": 1,
      "label": "first ask",
      "agency": "hers",
      "scaffold": "The first stage of the arc is requested by her, in her words; nothing is done to her that she has not asked for."
    },
    {
      "stage": 2,
      "label": "deepening",
      "agency": "hers",
      "scaffold": "Each stage adds exactly one loss or gain on top of the stages before it; the ladder is cumulative, never a reset."
    },
    {
      "stage": 3,
      "label": "the flip",
      "agency": "flips",
      "scaffold": "The agency flip sits here, at the arc's structural midpoint: what she asked for begins, by her own account, to ask things of her."
    },
    {
      "stage": 4,
      "label": "the old frame retires",
      "agency": "the arc's",
      "scaffold": "The authored rupture line lands at this slot, verbatim, in her voice; the old frame is named as it goes."
    },
    {
      "stage": 5,
      "label": "the new normal",
      "agency": "the arc's, by her request",
      "scaffold": "The endpoint is a settled state she inhabits fully, not an emptied one; the refrain returns, character-exact, to close."
    }

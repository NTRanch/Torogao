            id: "line.001",
            next: "line.002",
            speaker: "prima",
            text_ref: "line.001",
        ),
        DialogueLine(
            audio_binding: "voice-prima-002",
            id: "line.002",
            next: "",
            speaker: "prima",
            text_ref: "line.002",
        ),
    ],
)

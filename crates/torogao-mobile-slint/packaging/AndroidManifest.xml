<?xml version="1.0" encoding="utf-8"?>
<!-- Torogao Mobile (Slint shell) — hand-written manifest, no Gradle.
     The activity is the platform NativeActivity; it loads
     libtorogao_mobile_slint.so and calls android_main. The package
     carries classes.dex (Slint's Android Java helper, built and
     dexed by the i-slint-backend-android-activity build script and
     EMBEDDED in the native library, which loads it in memory at
     runtime — the APK itself carries no dex (hasCode=false).
     Packaging the dex as well splits Slint's package-private Java
     classes across two class loaders and the helper dies with
     IllegalAccessError; proven on the AVD, 2026-11-26). INTERNET is the only
     permission: the app is a client of the estate ComfyUI seat. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.ntranch.torogao.mobile"
    android:versionCode="2"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Torogao Mobile"
        android:hasCode="false">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="torogao_mobile_slint" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

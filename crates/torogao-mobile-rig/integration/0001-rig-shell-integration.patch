diff --git a/crates/torogao-mobile-facade/src/rig.rs b/crates/torogao-mobile-facade/src/rig.rs
new file mode 100644
index 0000000..e6a0eac
--- /dev/null
+++ b/crates/torogao-mobile-facade/src/rig.rs
@@ -0,0 +1,393 @@
+//! Rig routes — the facade's half of the rig lane
+//! (integration patch 0001; ARCHITECTURE §2/§5).
+//!
+//! The facade is the only door for rig work too: it validates
+//! rig job documents with the `torogao-mobile-rig` crate
+//! itself (hash pinning + the derive gate, seat-side, so a
+//! tampered client cannot talk the seat into an unlocked
+//! derivation), forwards them to the primo rig engine
+//! (`torogao-rig-engine`, a builder-service wrapping the
+//! gated fleet builders), and — when a derive finishes —
+//! computes the gate verdicts with the crate's gate module
+//! over the instruments' raw output, files the GLB and
+//! stills, and returns the updated record. The phone never
+//! solves and never gates; neither does the engine.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::time::Duration;
+
+use serde_json::{Value, json};
+use torogao_mobile_rig::gate::{derive_eligibility, judge};
+use torogao_mobile_rig::jobs::{MeasuredMorph, RigJobDocument, RigJobKind, RigJobResult};
+use torogao_mobile_rig::morphs;
+
+use crate::{ENGINE_POLL_INTERVAL, ENGINE_WAKE_DEADLINE_SECS, Facade, Reply, unix_now};
+
+/// One rig job as the facade tracks it.
+pub struct RigJob {
+    /// The validated job document.
+    doc: RigJobDocument,
+    /// Engine-side job id, once forwarded.
+    engine_id: Option<String>,
+    /// The terminal reply JSON, once assembled.
+    done: Option<Value>,
+    /// The terminal failure, when the job errored.
+    error: Option<String>,
+    /// Cancelled by the user; wins over later state writes.
+    cancelled: bool,
+}
+
+/// The rig engine's state as the facade sees it:
+/// (ready, engine id).
+fn rig_engine_state(facade: &Facade) -> (bool, String) {
+    let url = format!("{}/health", facade.rig_engine_url);
+    match ureq::get(&url).timeout(Duration::from_secs(5)).call() {
+        Ok(r) => match r.into_json::<Value>() {
+            Ok(body) => {
+                let engine = body
+                    .get("engine")
+                    .and_then(Value::as_str)
+                    .unwrap_or("unknown")
+                    .to_string();
+                let ready = body.get("model_loaded").and_then(Value::as_bool) == Some(true);
+                (ready, engine)
+            }
+            Err(_) => (false, "unknown".to_string()),
+        },
+        Err(_) => (false, "unknown".to_string()),
+    }
+}
+
+/// Start the rig engine's user service. Fire-and-forget.
+fn wake_rig_engine(facade: &Facade) {
+    let _ = std::process::Command::new("systemctl")
+        .args(["--user", "start", &facade.rig_engine_service])
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn();
+}
+
+/// The rig block of the health reply: engine id + seat state,
+/// plus the capabilities listing.
+pub fn rig_health_block(facade: &Facade) -> Value {
+    let (ready, engine) = rig_engine_state(facade);
+    json!({
+        "rig_engine": engine,
+        "rig_seat": if ready { "ready" } else { "down" },
+    })
+}
+
+fn set_rig_error(facade: &Facade, prompt_id: &str, message: String) {
+    if let Some(job) = facade.rig_jobs.lock().unwrap().get_mut(prompt_id) {
+        if !job.cancelled {
+            job.error = Some(message);
+        }
+    }
+}
+
+/// Hold a rig job until the rig engine is ready, then
+/// forward the document. Mirrors the gen lane's
+/// `forward_when_ready` discipline and deadline.
+fn forward_rig_when_ready(facade: Arc<Facade>, prompt_id: String, doc: RigJobDocument) {
+    let deadline = unix_now() + ENGINE_WAKE_DEADLINE_SECS;
+    loop {
+        {
+            let jobs = facade.rig_jobs.lock().unwrap();
+            match jobs.get(&prompt_id) {
+                Some(job) if !job.cancelled => {}
+                _ => return,
+            }
+        }
+        match rig_engine_state(&facade).0 {
+            true => break,
+            false => wake_rig_engine(&facade),
+        }
+        if unix_now() >= deadline {
+            set_rig_error(
+                &facade,
+                &prompt_id,
+                format!("the rig engine did not become ready within {ENGINE_WAKE_DEADLINE_SECS}s"),
+            );
+            return;
+        }
+        std::thread::sleep(ENGINE_POLL_INTERVAL);
+    }
+    let body = serde_json::to_value(&doc).unwrap_or(Value::Null);
+    let url = format!("{}/jobs", facade.rig_engine_url);
+    match ureq::post(&url)
+        .timeout(Duration::from_secs(30))
+        .send_json(body)
+    {
+        Ok(r) => match r.into_json::<Value>() {
+            Ok(v) => match v.get("id").and_then(Value::as_str) {
+                Some(id) => {
+                    if let Some(job) = facade.rig_jobs.lock().unwrap().get_mut(&prompt_id) {
+                        job.engine_id = Some(id.to_string());
+                    }
+                }
+                None => set_rig_error(
+                    &facade,
+                    &prompt_id,
+                    "rig engine reply had no job id".to_string(),
+                ),
+            },
+            Err(e) => set_rig_error(
+                &facade,
+                &prompt_id,
+                format!("unreadable rig engine reply: {e}"),
+            ),
+        },
+        Err(e) => set_rig_error(
+            &facade,
+            &prompt_id,
+            format!("rig engine refused the job: {e}"),
+        ),
+    }
+}
+
+/// `POST /rig/prompt`: validate a rig job document and queue
+/// it. The `X-Job-Sha256` header must match the document's
+/// canonical hash, the document's embedded hashes must
+/// verify, and a derive must pass the Step 0 derive gate —
+/// refusals are 400 (hash) or 422 (gate), with reasons.
+pub fn rig_submit(facade: &Arc<Facade>, headers: &HashMap<String, String>, body: &[u8]) -> Reply {
+    let json_reply = |code: u32, v: Value| Reply::Json(code, v);
+    let doc: RigJobDocument = match serde_json::from_slice(body) {
+        Ok(d) => d,
+        Err(e) => return json_reply(400, json!({"error": format!("bad job document: {e}")})),
+    };
+    let presented = headers.get("x-job-sha256").map(String::as_str);
+    if presented != Some(doc.sha256().as_str()) {
+        return json_reply(400, json!({"error": "job hash mismatch"}));
+    }
+    if !doc.verify_hashes() {
+        return json_reply(400, json!({"error": "document hashes do not verify"}));
+    }
+    if doc.kind == RigJobKind::Derive {
+        if let Err(reasons) = derive_eligibility(&doc.record) {
+            return json_reply(
+                422,
+                json!({"error": format!("derive refused: {}", reasons.join("; "))}),
+            );
+        }
+    }
+    let prompt_id = {
+        let mut next = facade.next_id.lock().unwrap();
+        let id = format!("rig-{}", *next);
+        *next += 1;
+        id
+    };
+    facade.rig_jobs.lock().unwrap().insert(
+        prompt_id.clone(),
+        RigJob {
+            doc: doc.clone(),
+            engine_id: None,
+            done: None,
+            error: None,
+            cancelled: false,
+        },
+    );
+    let f = Arc::clone(facade);
+    let pid = prompt_id.clone();
+    std::thread::spawn(move || forward_rig_when_ready(f, pid, doc));
+    json_reply(200, json!({"prompt_id": prompt_id}))
+}
+
+/// File one base64 artefact into the outputs directory;
+/// returns its file name. Names are built facade-side from
+/// the prompt id and the engine's plain file name — no
+/// traversal survives the check.
+fn file_artefact(facade: &Facade, prompt_id: &str, engine_name: &str, b64: &str) -> Option<String> {
+    if engine_name.contains('/') || engine_name.contains('\\') || engine_name.contains("..") {
+        return None;
+    }
+    let bytes = crate::base64_decode(b64)?;
+    let filename = format!("torogao_rig_{prompt_id}_{engine_name}");
+    std::fs::write(facade.outputs_dir.join(&filename), bytes).ok()?;
+    Some(filename)
+}
+
+/// Assemble the terminal reply for a finished engine job:
+/// file the artefacts, compute the verdicts (derive), and
+/// build the RigJobResult the client parses.
+fn assemble_done(facade: &Facade, prompt_id: &str, doc: &RigJobDocument, engine: &Value) -> Value {
+    let mut stills = Vec::new();
+    if let Some(list) = engine
+        .get("artifacts")
+        .and_then(|a| a.get("stills"))
+        .and_then(Value::as_array)
+    {
+        for still in list {
+            if let (Some(name), Some(b64)) = (
+                still.get("filename").and_then(Value::as_str),
+                still.get("png_base64").and_then(Value::as_str),
+            ) {
+                if let Some(filed) = file_artefact(facade, prompt_id, name, b64) {
+                    stills.push(filed);
+                }
+            }
+        }
+    }
+    let mut result = RigJobResult {
+        state: "done".to_string(),
+        ..RigJobResult::default()
+    };
+    result.stills = stills;
+    let mut glb_filename = None;
+    if doc.kind == RigJobKind::Derive {
+        if let Some(b64) = engine
+            .get("artifacts")
+            .and_then(|a| a.get("glb_base64"))
+            .and_then(Value::as_str)
+        {
+            glb_filename = file_artefact(facade, prompt_id, "gated.glb", b64);
+        }
+        let str_of = |key: &str| {
+            engine
+                .get(key)
+                .and_then(Value::as_str)
+                .unwrap_or("")
+                .to_string()
+        };
+        let gates = judge(
+            &doc.record,
+            str_of("glb_sha256"),
+            str_of("twin_sha256"),
+            str_of("builder_sha256"),
+            str_of("derived_at"),
+            engine.get("battery").unwrap_or(&Value::Null),
+            engine.get("census").unwrap_or(&Value::Null),
+        );
+        let mut updated = doc.record.clone();
+        updated.revision += 1;
+        updated.updated_at = gates.derived_at.clone();
+        if gates.is_gated() {
+            updated.rig.gated_glb_sha256 = Some(gates.derived_glb_sha256.clone());
+        }
+        updated.rig.gates = Some(gates);
+        result.record = Some(updated);
+    }
+    if doc.kind == RigJobKind::PoseTest {
+        if let Some(list) = engine.get("measured_morphs").and_then(Value::as_array) {
+            result.measured_morphs = list
+                .iter()
+                .map(|m| {
+                    let name = m.get("name").and_then(Value::as_str).unwrap_or("");
+                    MeasuredMorph {
+                        name: name.to_string(),
+                        weight: m.get("weight").and_then(Value::as_f64).unwrap_or(0.0),
+                        max_displacement_m: m
+                            .get("max_displacement_m")
+                            .and_then(Value::as_f64)
+                            .unwrap_or(0.0),
+                        mechanism: morphs::mechanism(name)
+                            .map(|mm| mm.mechanism.to_string())
+                            .unwrap_or_else(|| "no mechanism on record".to_string()),
+                    }
+                })
+                .collect();
+        }
+    }
+    let mut reply = json!({
+        "state": "done",
+        "rig": serde_json::to_value(&result).unwrap_or(Value::Null),
+    });
+    if let Some(name) = glb_filename {
+        reply["glb_filename"] = json!(name);
+    }
+    reply
+}
+
+/// `GET /rig/history/<id>`: the client's poll. Replies
+/// `{"state": "running"}` until the engine finishes, then
+/// the assembled terminal document (cached).
+pub fn rig_history(facade: &Arc<Facade>, prompt_id: &str) -> Reply {
+    let json_reply = |v: Value| Reply::Json(200, v);
+    let (doc, engine_id, done, error, cancelled) = {
+        let jobs = facade.rig_jobs.lock().unwrap();
+        match jobs.get(prompt_id) {
+            Some(job) => (
+                job.doc.clone(),
+                job.engine_id.clone(),
+                job.done.clone(),
+                job.error.clone(),
+                job.cancelled,
+            ),
+            None => {
+                return json_reply(
+                    json!({"state": "error", "rig": {"state": "error", "error": "no such job"}}),
+                );
+            }
+        }
+    };
+    if let Some(done) = done {
+        return json_reply(done);
+    }
+    if cancelled {
+        return json_reply(json!({"state": "cancelled", "rig": {"state": "cancelled"}}));
+    }
+    if let Some(error) = error {
+        return json_reply(json!({"state": "error", "rig": {"state": "error", "error": error}}));
+    }
+    let Some(engine_id) = engine_id else {
+        return json_reply(json!({"state": "running"}));
+    };
+    let url = format!("{}/jobs/{engine_id}", facade.rig_engine_url);
+    match ureq::get(&url).timeout(Duration::from_secs(30)).call() {
+        Ok(r) => match r.into_json::<Value>() {
+            Ok(v) => match v.get("state").and_then(Value::as_str) {
+                Some("done") => {
+                    let reply = assemble_done(facade, prompt_id, &doc, &v);
+                    if let Some(job) = facade.rig_jobs.lock().unwrap().get_mut(prompt_id) {
+                        job.done = Some(reply.clone());
+                    }
+                    json_reply(reply)
+                }
+                Some("error") => {
+                    let msg = v
+                        .get("error")
+                        .and_then(Value::as_str)
+                        .unwrap_or("rig engine error")
+                        .to_string();
+                    set_rig_error(facade, prompt_id, msg.clone());
+                    json_reply(json!({"state": "error", "rig": {"state": "error", "error": msg}}))
+                }
+                Some("cancelled") => {
+                    json_reply(json!({"state": "cancelled", "rig": {"state": "cancelled"}}))
+                }
+                _ => json_reply(json!({"state": "running"})),
+            },
+            Err(e) => json_reply(
+                json!({"state": "running", "note": format!("unreadable engine reply: {e}")}),
+            ),
+        },
+        Err(_) => json_reply(json!({"state": "running"})),
+    }
+}
+
+/// `POST /rig/interrupt`: cancel a rig job facade-side and
+/// forward the interrupt to the engine.
+pub fn rig_interrupt(facade: &Arc<Facade>, body: &[u8]) -> Reply {
+    let parsed: Value = serde_json::from_slice(body).unwrap_or(json!({}));
+    let Some(prompt_id) = parsed.get("prompt_id").and_then(Value::as_str) else {
+        return Reply::Json(400, json!({"error": "no prompt_id"}));
+    };
+    let engine_id = {
+        let mut jobs = facade.rig_jobs.lock().unwrap();
+        match jobs.get_mut(prompt_id) {
+            Some(job) => {
+                job.cancelled = true;
+                job.engine_id.clone()
+            }
+            None => None,
+        }
+    };
+    if let Some(engine_id) = engine_id {
+        let url = format!("{}/jobs/{engine_id}/interrupt", facade.rig_engine_url);
+        let _ = ureq::post(&url)
+            .timeout(Duration::from_secs(5))
+            .send_json(json!({}));
+    }
+    Reply::Json(200, json!({"interrupted": prompt_id}))
+}

diff --git a/crates/torogao-mobile-slint/src/rig_ui.rs b/crates/torogao-mobile-slint/src/rig_ui.rs
new file mode 100644
index 0000000..e51fce1
--- /dev/null
+++ b/crates/torogao-mobile-slint/src/rig_ui.rs
@@ -0,0 +1,445 @@
+//! Rig screen wiring (integration patch 0001): the shell's
+//! half of the rig lane.
+//!
+//! Records live as JSON files in `<session dir>/rig-records/`
+//! — one `torogao-character/1` document per character,
+//! seeded from the crate's migrated cast on first run. The
+//! screen edits the record (parameters are applied and the
+//! revision bumped here, in the open), and derivation /
+//! pose tests / previews run as facade jobs through
+//! `torogao_mobile_rig::RigClient` on a worker thread; the
+//! updated record the facade returns is adopted whole and
+//! re-filed. Nothing is solved or gated on-device.
+
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+
+use slint::{ComponentHandle, Image, ModelRc, VecModel};
+use torogao_mobile_rig::cast_records::migrated_cast;
+use torogao_mobile_rig::client::RigClient;
+use torogao_mobile_rig::gate::{Verdict, derive_eligibility};
+use torogao_mobile_rig::jobs::RigJobDocument;
+use torogao_mobile_rig::schema::{CharacterRecord, ExpressionSetting};
+
+use crate::{AppWindow, Shell};
+
+/// The rig screen's working state.
+struct RigState {
+    records: Vec<CharacterRecord>,
+    current: usize,
+    dir: PathBuf,
+    /// The facade file name of the last derive's gated GLB
+    /// (for Export).
+    last_glb_filename: Option<String>,
+}
+
+fn iso_now() -> String {
+    let secs = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0);
+    let days = (secs / 86_400) as i64;
+    let tod = secs % 86_400;
+    // Civil-from-days (Howard Hinnant's algorithm).
+    let z = days + 719_468;
+    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let y = if m <= 2 { y + 1 } else { y };
+    format!(
+        "{y:04}-{m:02}-{d:02}T{:02}:{:02}:{:02}Z",
+        tod / 3600,
+        (tod % 3600) / 60,
+        tod % 60
+    )
+}
+
+fn records_dir(shell: &Shell) -> Option<PathBuf> {
+    let session = shell.session.as_ref()?;
+    let dir = session.dir().join("rig-records");
+    let _ = std::fs::create_dir_all(&dir);
+    Some(dir)
+}
+
+fn load_records(dir: &Path) -> Vec<CharacterRecord> {
+    let mut records = Vec::new();
+    if let Ok(entries) = std::fs::read_dir(dir) {
+        let mut paths: Vec<PathBuf> = entries
+            .flatten()
+            .map(|e| e.path())
+            .filter(|p| p.extension().is_some_and(|x| x == "json"))
+            .collect();
+        paths.sort();
+        for path in paths {
+            if let Ok(text) = std::fs::read_to_string(&path) {
+                if let Ok(record) = serde_json::from_str::<CharacterRecord>(&text) {
+                    records.push(record);
+                }
+            }
+        }
+    }
+    if records.is_empty() {
+        // First run: seed the migrated cast of record.
+        for record in migrated_cast(&iso_now()) {
+            save_record(dir, &record);
+            records.push(record);
+        }
+    }
+    records
+}
+
+fn save_record(dir: &Path, record: &CharacterRecord) {
+    let path = dir.join(format!("{}.json", record.id));
+    if let Ok(text) = serde_json::to_string_pretty(record) {
+        let _ = std::fs::write(path, text);
+    }
+}
+
+fn verdict_word(v: Verdict) -> &'static str {
+    match v {
+        Verdict::Pass => "PASS",
+        Verdict::Fail => "FAIL",
+        Verdict::NotRun => "not run",
+    }
+}
+
+fn refresh(ui: &AppWindow, state: &RigState) {
+    let names: Vec<slint::SharedString> = state
+        .records
+        .iter()
+        .map(|r| slint::SharedString::from(r.name.as_str()))
+        .collect();
+    ui.set_rig_record_names(ModelRc::new(VecModel::from(names)));
+    ui.set_rig_record_index(state.current as i32);
+    let Some(record) = state.records.get(state.current) else {
+        return;
+    };
+    let lock = &record.identity_lock;
+    let lock_line = match lock.status {
+        torogao_mobile_rig::schema::LockStatus::Locked => format!(
+            "Step 0 identity lock: HELD (by {}, {})",
+            lock.locked_by.as_deref().unwrap_or("?"),
+            lock.locked_at.as_deref().unwrap_or("?")
+        ),
+        torogao_mobile_rig::schema::LockStatus::Unlocked => {
+            "Step 0 identity lock: NOT HELD — derivation is refused; art generation stays available."
+                .to_string()
+        }
+    };
+    match derive_eligibility(record) {
+        Ok(()) => {
+            ui.set_rig_can_derive(true);
+            ui.set_rig_lock_line(lock_line.into());
+        }
+        Err(reasons) => {
+            ui.set_rig_can_derive(false);
+            ui.set_rig_lock_line(
+                format!("{}\nDerive blocked: {}", lock_line, reasons.join("; ")).into(),
+            );
+        }
+    }
+    ui.set_rig_has_gated_glb(record.rig.gated_glb_sha256.is_some());
+    let bp = &record.body_params;
+    ui.set_rig_z_scale(format!("{:.4}", bp.z_scale).into());
+    ui.set_rig_radial_scale(format!("{:.3}", bp.radial_scale).into());
+    ui.set_rig_bust_amp(format!("{:.3}", bp.bust_amp).into());
+    ui.set_rig_waist_scale(format!("{:.3}", bp.waist_scale).into());
+    ui.set_rig_hip_scale(format!("{:.3}", bp.hip_scale).into());
+    ui.set_rig_hair_style(bp.hair_style.clone().into());
+    match &record.rig.gates {
+        Some(g) => {
+            let label = if g.is_gated() {
+                "GATED"
+            } else {
+                "CONSTRUCTION"
+            };
+            ui.set_rig_verdict(
+                format!(
+                    "{label} — A10.1 {} · A10.2 {} · lock check {} · twin {} · GLB {}…",
+                    verdict_word(g.a10_1.verdict),
+                    verdict_word(g.a10_2.verdict),
+                    verdict_word(g.lock_check.verdict),
+                    if g.determinism {
+                        "identical"
+                    } else {
+                        "DIFFERS"
+                    },
+                    &g.derived_glb_sha256[..12.min(g.derived_glb_sha256.len())]
+                )
+                .into(),
+            );
+        }
+        None => ui.set_rig_verdict("No derivation on record yet.".into()),
+    }
+}
+
+fn seat_client(shell: &Shell) -> Result<RigClient, String> {
+    let session = shell.session.as_ref().ok_or("no session")?;
+    let settings = session.settings();
+    let seat = settings.active_seat().ok_or("no active seat configured")?;
+    Ok(RigClient::new(seat.base_url.clone()).with_token(seat.token.clone()))
+}
+
+/// Wire the rig screen's callbacks. Called once from
+/// `run()`; additive — no existing callback is touched.
+pub fn wire(ui: &AppWindow, shell: &Arc<Shell>) {
+    let Some(dir) = records_dir(shell) else {
+        ui.set_rig_status("Rig records unavailable (no session).".into());
+        return;
+    };
+    let state = Arc::new(Mutex::new(RigState {
+        records: load_records(&dir),
+        current: 0,
+        dir,
+        last_glb_filename: None,
+    }));
+    refresh(ui, &state.lock().unwrap());
+
+    // ---- record picker ----
+    {
+        let state = Arc::clone(&state);
+        let weak = ui.as_weak();
+        ui.on_rig_load(move |index| {
+            let Some(ui) = weak.upgrade() else { return };
+            let mut st = state.lock().unwrap();
+            if (index as usize) < st.records.len() {
+                st.current = index as usize;
+            }
+            refresh(&ui, &st);
+        });
+    }
+
+    // ---- parameter edits ----
+    {
+        let state = Arc::clone(&state);
+        let weak = ui.as_weak();
+        ui.on_rig_apply_params(move || {
+            let Some(ui) = weak.upgrade() else { return };
+            let mut st = state.lock().unwrap();
+            let current = st.current;
+            let dir = st.dir.clone();
+            let Some(record) = st.records.get_mut(current) else {
+                return;
+            };
+            let parse = |s: slint::SharedString| s.parse::<f64>();
+            let fields = [
+                parse(ui.get_rig_z_scale()),
+                parse(ui.get_rig_radial_scale()),
+                parse(ui.get_rig_bust_amp()),
+                parse(ui.get_rig_waist_scale()),
+                parse(ui.get_rig_hip_scale()),
+            ];
+            if fields.iter().any(|f| f.is_err()) {
+                ui.set_rig_status("A parameter is not a number — nothing applied.".into());
+                return;
+            }
+            let mut vals = fields.into_iter().map(|f| f.unwrap_or(0.0));
+            record.body_params.z_scale = vals.next().unwrap_or(1.0);
+            record.body_params.radial_scale = vals.next().unwrap_or(1.0);
+            record.body_params.bust_amp = vals.next().unwrap_or(0.0);
+            record.body_params.waist_scale = vals.next().unwrap_or(1.0);
+            record.body_params.hip_scale = vals.next().unwrap_or(1.0);
+            record.body_params.hair_style = ui.get_rig_hair_style().to_string();
+            let problems = record.validate();
+            if !problems.is_empty() {
+                ui.set_rig_status(format!("Refused: {}", problems.join("; ")).into());
+                return;
+            }
+            record.revision += 1;
+            record.updated_at = iso_now();
+            save_record(&dir, record);
+            ui.set_rig_status(
+                format!("Parameters applied — record revision {}.", record.revision).into(),
+            );
+            refresh(&ui, &st);
+        });
+    }
+
+    // ---- job runners (derive / pose / preview) ----
+    {
+        let shell = Arc::clone(shell);
+        let state = Arc::clone(&state);
+        let weak = ui.as_weak();
+        ui.on_rig_derive(move || run_job(&weak, &shell, &state, JobKindUi::Derive));
+    }
+    {
+        let shell = Arc::clone(shell);
+        let state = Arc::clone(&state);
+        let weak = ui.as_weak();
+        ui.on_rig_pose_test(move || run_job(&weak, &shell, &state, JobKindUi::PoseTest));
+    }
+    {
+        let shell = Arc::clone(shell);
+        let state = Arc::clone(&state);
+        let weak = ui.as_weak();
+        ui.on_rig_preview(move || run_job(&weak, &shell, &state, JobKindUi::Preview));
+    }
+
+    // ---- export ----
+    {
+        let shell = Arc::clone(shell);
+        let state = Arc::clone(&state);
+        let weak = ui.as_weak();
+        ui.on_rig_export(move || {
+            let Some(ui) = weak.upgrade() else { return };
+            let (client, filename, id) = {
+                let st = state.lock().unwrap();
+                let Some(record) = st.records.get(st.current) else {
+                    return;
+                };
+                match (seat_client(&shell), st.last_glb_filename.clone()) {
+                    (Ok(c), Some(f)) => (c, f, record.id.clone()),
+                    _ => {
+                        ui.set_rig_status("Nothing to export yet — run a derivation first.".into());
+                        return;
+                    }
+                }
+            };
+            let exports = shell.exports_dir.clone();
+            let weak2 = weak.clone();
+            std::thread::spawn(move || {
+                let outcome = client.fetch_view(&filename).and_then(|bytes| {
+                    let path = exports.join(format!("{id}.glb"));
+                    std::fs::write(&path, &bytes).map_err(|e| {
+                        torogao_mobile_rig::client::RigError::Unreachable(e.to_string())
+                    })?;
+                    Ok(path)
+                });
+                let _ = weak2.upgrade_in_event_loop(move |ui| match outcome {
+                    Ok(path) => ui.set_rig_status(
+                        format!("Exported the gated GLB to {}.", path.display()).into(),
+                    ),
+                    Err(e) => ui.set_rig_status(e.message().into()),
+                });
+            });
+        });
+    }
+}
+
+#[derive(Clone, Copy)]
+enum JobKindUi {
+    Derive,
+    PoseTest,
+    Preview,
+}
+
+/// Run one rig job for the current record on a worker
+/// thread; the terminal state lands back on the event loop.
+fn run_job(
+    weak: &slint::Weak<AppWindow>,
+    shell: &Arc<Shell>,
+    state: &Arc<Mutex<RigState>>,
+    kind: JobKindUi,
+) {
+    let Some(ui) = weak.upgrade() else { return };
+    let (record, smile, close) = {
+        let st = state.lock().unwrap();
+        let Some(record) = st.records.get(st.current) else {
+            return;
+        };
+        (
+            record.clone(),
+            ui.get_rig_smile_weight().parse::<f64>().unwrap_or(1.0),
+            ui.get_rig_eye_close_weight().parse::<f64>().unwrap_or(0.5),
+        )
+    };
+    let doc = match kind {
+        JobKindUi::Derive => RigJobDocument::derive(&record),
+        JobKindUi::PoseTest => RigJobDocument::pose_test(
+            &record,
+            vec![
+                ExpressionSetting {
+                    name: "Fac_Mth_Smile".to_string(),
+                    weight: smile,
+                },
+                ExpressionSetting {
+                    name: "Fac_Eye_Close".to_string(),
+                    weight: close,
+                },
+            ],
+        ),
+        JobKindUi::Preview => RigJobDocument::preview_render(&record),
+    };
+    let doc = match doc {
+        Ok(d) => d,
+        Err(problems) => {
+            ui.set_rig_status(format!("Refused: {}", problems.join("; ")).into());
+            return;
+        }
+    };
+    let client = match seat_client(shell) {
+        Ok(c) => c,
+        Err(e) => {
+            ui.set_rig_status(format!("No seat: {e}").into());
+            return;
+        }
+    };
+    ui.set_rig_busy(true);
+    ui.set_rig_status("Working on the computer…".into());
+    let weak2 = weak.clone();
+    let state2 = Arc::clone(state);
+    std::thread::spawn(move || {
+        let outcome = client.run(&doc).map(|out| {
+            // Fetch the first still back for the preview slot.
+            let still = out
+                .result
+                .stills
+                .first()
+                .and_then(|name| client.fetch_view(name).ok().map(|b| (name.clone(), b)));
+            (out, still)
+        });
+        let _ = weak2.upgrade_in_event_loop(move |ui| {
+            ui.set_rig_busy(false);
+            match outcome {
+                Ok((out, still)) => {
+                    let mut st = state2.lock().unwrap();
+                    if let Some(updated) = &out.result.record {
+                        if let Some(slot) = st.records.iter_mut().find(|r| r.id == updated.id) {
+                            *slot = updated.clone();
+                        }
+                        save_record(&st.dir, updated);
+                    }
+                    if out.glb_filename.is_some() {
+                        st.last_glb_filename = out.glb_filename.clone();
+                    }
+                    if let Some((name, bytes)) = still {
+                        let dir = st.dir.join("stills");
+                        let _ = std::fs::create_dir_all(&dir);
+                        let path = dir.join(&name);
+                        if std::fs::write(&path, &bytes).is_ok() {
+                            if let Ok(img) = Image::load_from_path(&path) {
+                                ui.set_rig_still(img);
+                                ui.set_rig_has_still(true);
+                            }
+                        }
+                    }
+                    if !out.result.measured_morphs.is_empty() {
+                        let lines: Vec<String> = out
+                            .result
+                            .measured_morphs
+                            .iter()
+                            .map(|m| {
+                                format!(
+                                    "{} @ {:.2}: max displacement {:.1} mm — {}",
+                                    m.name,
+                                    m.weight,
+                                    m.max_displacement_m * 1000.0,
+                                    m.mechanism
+                                )
+                            })
+                            .collect();
+                        ui.set_rig_pose_line(lines.join("\n").into());
+                    }
+                    ui.set_rig_status("Done.".into());
+                    refresh(&ui, &st);
+                }
+                Err(e) => ui.set_rig_status(e.message().into()),
+            }
+        });
+    });
+}
